---
import Button from '../ui/Button.astro';
import { CONTACT, CV_URL } from '../../lib/site';

const links = [
  { label: 'Email', text: CONTACT.email, href: `mailto:${CONTACT.email}` },
  { label: 'LinkedIn', text: 'linkedin.com/in/arvinroeslim', href: CONTACT.linkedin },
  { label: 'GitHub', text: 'github.com/arvinr11', href: CONTACT.github },
];
---

<section id="contact" class="contact">
  <div class="wrap">
    <h2 class="display-l reveal">Hiring a mobile<br />developer?</h2>
    <p class="body-l reveal">I reply within a day. Email is fastest.</p>
    <div class="links reveal">
      {
        links.map((l) => (
          <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}>
            <span class="label">{l.label}</span>
            <span class="links__text">{l.text}</span>
          </a>
        ))
      }
    </div>
    <div class="cta">
      <Button href={CV_URL} icon="download" download>Download CV</Button>
    </div>
    <footer class="foot">
      <span>
        Made with
        <svg width="18" height="18" viewBox="0 0 24 24" role="img" aria-label="love">
          <path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.8 4.5c2.2 0 3.6 1.3 4.2 2.4h2c.6-1.1 2-2.4 4.2-2.4 3.8 0 5.9 3.9 4.4 7.3C19.5 16.4 12 21 12 21z" fill="#121433" />
        </svg>
        by Arvin · © 2026
      </span>
    </footer>
  </div>
</section>

<style>
  .contact { padding-bottom: 40px; background: var(--tangerine); }
  .contact .body-l { margin: 28px 0 40px; }
  .links a { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 24px 0; border-top: 2px solid var(--ink); }
  .links__text { font: 400 clamp(22px, 2.8vw, 40px)/1 var(--display); overflow-wrap: anywhere; text-align: right; }
  .links a:hover .links__text { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .cta { margin: 40px 0 64px; }
  .foot { display: flex; justify-content: center; padding-top: 32px; border-top: 2px solid var(--ink); font: 700 15px/1 var(--text); }
  .foot span { display: inline-flex; align-items: center; gap: 8px; }
  @media (max-width: 720px) {
    .links a { flex-direction: column; align-items: flex-start; }
    .links__text { text-align: left; font-size: 20px; }
  }
</style>
