---
import { logoForLabel } from '../../lib/icons';

interface Props {
  label: string;
}

const { label } = Astro.props;
const logo = logoForLabel(label);
---

<span class="chip">
  {
    logo ? (
      <img class="chip__logo" src={logo} alt="" width="20" height="20" loading="lazy" decoding="async" />
    ) : (
      <i class="chip__dot" aria-hidden="true" />
    )
  }
  {label}
</span>

<style>
  .chip {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 9px 16px 9px 12px;
    border: 2px solid var(--ink); border-radius: 999px;
    background: var(--white); color: var(--ink);
    font: 800 15px/1 var(--text);
  }
  .chip__logo { width: 22px; height: 22px; object-fit: contain; }
  .chip__dot { width: 12px; height: 12px; border-radius: 999px; background: var(--ink); }
</style>
