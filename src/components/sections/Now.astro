---
const items = [
  { label: 'Work', text: 'Intern at PT Gading Murni' },
  { label: 'Study', text: 'Mobile Application & Technology, BINUS' },
  { label: 'Looking for', text: 'Full-time mobile developer roles' },
];
---

<div class="wrap now">
  <span class="label now__tag">Now</span>
  {
    items.map((item) => (
      <div class="now__item">
        <span class="label">{item.label}</span>
        <span>{item.text}</span>
      </div>
    ))
  }
</div>

<style>
  .now { display: grid; grid-template-columns: auto repeat(3, 1fr); align-items: center; padding-top: 40px; padding-bottom: 40px; }
  .now__tag {
    justify-self: start; margin-right: 32px; padding: 8px 14px;
    border: 2px solid var(--ink); border-radius: 999px; background: var(--sun); transform: rotate(-4deg);
  }
  .now__item { display: flex; flex-direction: column; gap: 6px; padding: 4px 24px; border-left: 2px solid var(--ink); font: 800 18px/1.3 var(--text); }
  .now__item .label { color: var(--ink-soft); }

  @media (max-width: 1100px) {
    .now { grid-template-columns: repeat(3, 1fr); row-gap: 20px; }
    .now__tag { grid-column: 1 / -1; }
    .now__item:first-of-type { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 720px) {
    .now { grid-template-columns: 1fr; }
    .now__item, .now__item:first-of-type { padding: 16px 0 0; border-left: 0; border-top: 2px solid var(--ink); font-size: 17px; }
  }
</style>
