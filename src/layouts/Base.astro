---
import '@fontsource/archivo-black';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import { CONTACT } from '../lib/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ogImage, Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Arvin Roeslim',
  jobTitle: 'Mobile Developer',
  url: Astro.site?.href,
  image: og.href,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'BINUS University' },
  worksFor: { '@type': 'Organization', name: 'PT Gading Murni' },
  knowsAbout: ['Flutter', 'Kotlin', 'Swift', 'Figma', 'Mobile app development'],
  sameAs: [CONTACT.linkedin, CONTACT.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2350F5" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arvin Roeslim" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={og.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.href} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
