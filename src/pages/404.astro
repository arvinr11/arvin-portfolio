---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
---

<Base title="Page not found · Arvin Roeslim" description="This page doesn't exist.">
  <main class="lost">
    <div class="wrap lost__inner">
      <span class="label">404</span>
      <h1 class="display-l">This page<br />doesn't exist</h1>
      <p class="body-l">The link may be old, or there's a typo in it.</p>
      <Button href="/" variant="primary">Back to the homepage</Button>
    </div>
  </main>
</Base>

<style>
  .lost { min-height: 100vh; display: grid; align-items: center; background: var(--cobalt); color: var(--paper); }
  .lost__inner { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; padding-top: 64px; padding-bottom: 64px; }
  .label { color: var(--sun); }
</style>
