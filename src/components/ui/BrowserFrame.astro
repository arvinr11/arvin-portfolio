---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  class?: string;
}

const { src, alt = '', class: extra } = Astro.props;
const ratio = src ? `${src.width} / ${src.height}` : '16 / 10';
---

<div class:list={['browser', extra]}>
  <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="browser__screen" style={`aspect-ratio: ${ratio}`}>
    {src && <Image src={src} alt={alt} width={800} loading="lazy" />}
  </div>
</div>

<style>
  .browser {
    width: 100%; overflow: hidden;
    border: 2px solid var(--ink); border-radius: 14px;
    background: var(--white); box-shadow: var(--shadow-hard);
  }
  .browser__bar { display: flex; gap: 6px; padding: 9px 12px; background: var(--paper); border-bottom: 2px solid var(--ink); }
  .browser__bar i { width: 8px; height: 8px; border-radius: 99px; background: var(--ink); }
  .browser__screen { background: var(--paper); overflow: hidden; }
  .browser__screen :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
</style>
