---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Sticker from '../ui/Sticker.astro';
import avatar from '../../assets/arvin-3d.png';
import { CV_URL } from '../../lib/site';
---

<header class="hero on-dark">
  <div class="wrap">
    <nav class="nav" aria-label="Main">
      <a class="nav__mark" href="/">arvin.</a>
      <div class="nav__links">
        <a href="#work">Work</a>
        <a href="#experience">Experience</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
      </div>
      <Button href={CV_URL} size="sm" icon="download" download>CV</Button>
    </nav>

    <div class="hero__grid">
      <div class="hero__intro">
        <span class="label">Mobile developer · Jakarta</span>
        <h1 class="display-xl"><span class="stamp">Arvin</span><br /><span class="stamp stamp--2">Roeslim</span></h1>
        <p class="body-l">I build mobile apps with Flutter, Kotlin and Swift, and design them in Figma first.</p>
        <div class="ctas">
          <Button href={CV_URL} variant="primary" icon="download" download>Download CV</Button>
          <Button href="#work">See my work</Button>
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <div class="arch">
          <Image
            class="portrait"
            src={avatar}
            alt=""
            width={1140}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <Sticker class="hero__sticker" lines={['Open', 'to work']} />
      </div>
    </div>
  </div>
  <div class="zigzag" aria-hidden="true"></div>
</header>

<script>
  import '../../scripts/avatar';
</script>

<style>
  .hero { position: relative; overflow: hidden; padding-bottom: 28px; background: var(--cobalt); color: var(--paper); }
  .nav { position: relative; z-index: 3; display: flex; align-items: center; justify-content: space-between; padding-top: 28px; }
  .nav__mark { font: 400 28px/1 var(--display); }
  .nav__links { display: flex; gap: 40px; font: 800 16px/1 var(--text); }
  .nav__links a:hover { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }

  .hero__grid {
    display: grid; grid-template-columns: 1.15fr .85fr; align-items: center; gap: 24px;
    min-height: 760px; padding-top: 24px; padding-bottom: 72px;
  }
  .hero__intro { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 28px; }
  .hero__intro .label { color: var(--sun-text); }
  .hero__intro p { max-width: 560px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 16px; }

  .hero__art { position: relative; height: 640px; align-self: end; }
  .arch {
    position: absolute; right: 0; bottom: -100px; width: 420px; height: 640px; overflow: hidden;
    border-radius: 210px 210px 0 0; background: var(--sky);
  }
  .arch :global(.portrait) {
    position: absolute; left: 50%; bottom: 0; width: 570px; max-width: none;
    transform: translate(calc(-50% + var(--px, 0px)), var(--py, 0px)) rotate(var(--pr, 0deg));
    transform-origin: 50% 100%; transition: transform .25s ease-out;
  }
  .hero__art :global(.hero__sticker) { left: -10px; top: 60px; z-index: 3; transform: rotate(-10deg); }

  .zigzag {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 4; height: 28px; background: var(--paper);
    -webkit-mask: conic-gradient(from 135deg at top, #000 90deg, #0000 0) 0 0 / 28px 28px repeat-x;
    mask: conic-gradient(from 135deg at top, #000 90deg, #0000 0) 0 0 / 28px 28px repeat-x;
  }

  /* Intro: plays once on load, only when motion is welcome. */
  @media (prefers-reduced-motion: no-preference) {
    .stamp { display: inline-block; animation: stamp .55s var(--ease-pop) both .05s; }
    .stamp--2 { animation-delay: .16s; }
    .hero__intro > .label, .hero__intro > p, .ctas { animation: rise .6s var(--ease-pop) both; }
    .hero__intro > p { animation-delay: .3s; }
    .ctas { animation-delay: .4s; }
    .arch :global(.portrait) { animation: avatar .8s cubic-bezier(.34, 1.3, .64, 1) both .25s; }
    .hero__art :global(.hero__sticker) { animation: pop .5s cubic-bezier(.34, 1.6, .64, 1) both .7s; }
    .hero__art :global(.hero__sticker:hover > *) { animation: wiggle .5s ease-in-out; }
  }
  @keyframes stamp { from { opacity: 0; scale: 1.12; } to { opacity: 1; scale: 1; } }
  @keyframes rise { from { opacity: 0; translate: 0 20px; } to { opacity: 1; translate: 0 0; } }
  @keyframes avatar { from { opacity: 0; translate: 0 90px; } to { opacity: 1; translate: 0 0; } }
  @keyframes pop { 0% { scale: 0; } 70% { scale: 1.12; } 100% { scale: 1; } }
  @keyframes wiggle { 0%, 100% { rotate: 0deg; } 25% { rotate: -7deg; } 75% { rotate: 7deg; } }

  @media (max-width: 1100px) {
    .hero__grid { grid-template-columns: 1fr; min-height: 0; padding-bottom: 0; }
    .hero__art { height: 640px; margin-top: 24px; }
    .arch { left: 50%; right: auto; margin-left: -190px; width: 380px; bottom: -140px; }
    .hero__art :global(.hero__sticker) { left: auto; right: 4%; top: -10px; }
  }
  @media (max-width: 720px) {
    .nav__links { display: none; }
    .hero__art { height: 420px; margin-top: 8px; }
    .arch { width: 300px; height: 500px; margin-left: -150px; bottom: -100px; }
    .arch :global(.portrait) { width: 440px; }
    .hero__art :global(.hero__sticker) { width: 116px; height: 116px; top: 0; right: 2%; }
    .hero__art :global(.hero__sticker span) { font-size: 12px; }
  }
</style>
