---
interface Props {
  lines: string[];
  class?: string;
}

const { lines, class: extra } = Astro.props;

// 12-point star: 24 vertices alternating between the outer and inner radius.
const points = Array.from({ length: 24 }, (_, i) => {
  const r = i % 2 ? 60 : 74;
  const a = (Math.PI * i) / 12 - Math.PI / 2;
  return `${(75 + r * Math.cos(a)).toFixed(1)},${(75 + r * Math.sin(a)).toFixed(1)}`;
}).join(' ');
---

<div class:list={['sticker', extra]}>
  <svg viewBox="0 0 150 150" aria-hidden="true">
    <polygon points={points} fill="#FFD447" stroke="#121433" stroke-width="2" stroke-linejoin="round" />
  </svg>
  <span>{lines.map((line, i) => (i ? [<br />, line] : line))}</span>
</div>

<style>
  .sticker {
    position: absolute; width: 150px; height: 150px;
    display: grid; place-items: center; text-align: center; color: var(--ink);
  }
  .sticker svg { position: absolute; inset: 0; }
  .sticker span {
    position: relative;
    font: 800 15px/1.2 var(--text); letter-spacing: .06em; text-transform: uppercase;
  }
</style>
